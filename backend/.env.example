# --- required ---
# Use the SAME Neon/Postgres database your OLC backend uses, so the account and XP are shared.
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require
# Long random string. MUST be the same value as OLC's JWT secret if you want one login token to work on both.
JWT_SECRET=change-me-to-a-long-random-string
# Comma-separated list of the frontends allowed to call this API (your Vercel / GitHub Pages URLs)
ALLOWED_ORIGINS=https://your-projukti.vercel.app,http://localhost:5500

# --- optional: point at OLC's EXISTING accounts table instead of the default one ---
# ACCOUNTS_TABLE=olc_accounts
# COL_USER=username
# COL_HASH=pass_hash
# COL_AVATAR=avatar
# COL_DISPLAY=display_name
# COL_RECOVERY_Q=recovery_q
# COL_RECOVERY_HASH=recovery_hash
